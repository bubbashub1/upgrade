{
  "$schema": "https://schemas.wp.org/wp/6.6/theme.json",
  "version": 3,
  "settings": {
    "appearanceTools": true,
    "layout": {"contentSize": "1180px", "wideSize": "1440px"},
    "color": {
      "custom": false,
      "palette": [
        {"slug":"green","color":"#18B97A","name":"Bubba Green"},
        {"slug":"dark","color":"#1A2E22","name":"Bubba Dark"},
        {"slug":"muted","color":"#7A9189","name":"Bubba Muted"},
        {"slug":"background","color":"#F0F7F4","name":"Bubba Background"},
        {"slug":"soft","color":"#E3F5EE","name":"Bubba Soft Green"},
        {"slug":"white","color":"#FFFFFF","name":"White"}
      ],
      "gradients": []
    },
    "spacing": {"units":["px","%","em","rem","vw","vh"]},
    "typography": {
      "fontFamilies": [
        {"fontFamily":"Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, \"Segoe UI\", sans-serif","slug":"inter","name":"Inter / System"}
      ],
      "fluid": true,
      "fontSizes": [
        {"slug":"small","size":"0.875rem","name":"Small"},
        {"slug":"medium","size":"1rem","name":"Medium"},
        {"slug":"large","size":"1.25rem","name":"Large"},
        {"slug":"x-large","size":"clamp(2rem,5vw,3.875rem)","name":"Hero"}
      ]
    }
  },
  "styles": {
    "color": {"background":"var:preset|color|background","text":"var:preset|color|dark"},
    "typography": {"fontFamily":"var:preset|font-family|inter","lineHeight":"1.55"},
    "spacing": {"blockGap":"1.25rem"},
    "elements": {
      "button": {"color":{"background":"var:preset|color|green","text":"#FFFFFF"},"border":{"radius":"12px"},"spacing":{"padding":{"top":"0.8rem","right":"1.1rem","bottom":"0.8rem","left":"1.1rem"}},"typography":{"fontWeight":"800"}},
      "heading": {"typography":{"fontWeight":"800","lineHeight":"1.1"}}
    }
  },
  "templateParts": [
    {"name":"header","title":"BubbaHub Header","area":"header"},
    {"name":"footer","title":"BubbaHub Footer","area":"footer"}
  ]
}
